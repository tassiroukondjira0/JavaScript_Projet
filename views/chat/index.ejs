<%- include('../partials/appShell', {
  language: language || 'fr',
  title: 'Messagerie',
  user,
  currentPath: '/messages',
  body: `
    <h2>Messagerie</h2>

    <section class="card">
      <div class="row" style="gap:12px; align-items:flex-start;">
        <div style="min-width:280px;">
          <h3>Conversations</h3>
          <button class="btn" id="btnLoadConvos" type="button">Charger</button>
          <button class="btn btn-primary" id="btnNewConversation" type="button" style="margin-left:8px;">Nouveau message</button>
          <ul id="convoList" style="list-style:none; padding:0; margin-top:12px;"></ul>
        </div>
        <div style="flex:1;">
          <h3 id="chatTitle">Messages</h3>
          <div id="typingIndicator" class="muted" style="min-height:18px; margin:6px 0;"></div>
          <div id="msgBox" style="border:1px solid var(--border); padding:10px; height:360px; overflow:auto; border-radius:8px; margin-bottom:10px;">
            <p class="muted" style="text-align:center;padding-top:160px;">Sélectionnez une conversation</p>
          </div>
          <div style="display:flex; gap:8px;">
            <input id="msgInput" class="input" placeholder="Écrire un message..." maxlength="2000" />
            <button class="btn btn-primary" id="btnSend" type="button">Envoyer</button>
          </div>
        </div>
      </div>
    </section>

    <!-- New conversation modal -->
    <div id="newConvoModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.6);z-index:9999;align-items:center;justify-content:center;">
      <div style="background:var(--card);padding:24px;border-radius:16px;max-width:480px;width:90%;">
        <h3>Nouveau message</h3>
        <p class="muted">Rechercher un utilisateur pour lui envoyer un message</p>
        <input id="newConvoSearch" class="input" placeholder="Rechercher par nom..." style="width:100%;box-sizing:border-box;margin:12px 0;" />
        <div id="newConvoResults" style="max-height:240px;overflow-y:auto;"></div>
        <button class="btn" id="btnCloseModal" type="button" style="margin-top:12px;">Fermer</button>
      </div>
    </div>

    <script src="/js/chatSocket.js"></script>
  `
}) %>