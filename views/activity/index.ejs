<%- include('../partials/appShell', {
  language: language || 'fr',
  title: 'Journal d\'activité',
  user,
  currentPath: '/activity',
  body: `
    <section class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
        <h2 style="margin:0;">Journal d'activité</h2>
        <span class="muted" style="font-size:13px;">Historique de vos actions récentes</span>
      </div>

      <div id="activity-list-container" style="margin-top:14px;">
        <p class="muted" style="text-align:center; padding:24px 0;">Chargement...</p>
      </div>
    </section>

    <script>
      function getActivityLabel(actionType) {
        const labels = {
          login: { icon: '🔑', text: 'Connexion à votre compte' },
          register: { icon: '🎉', text: 'Création de votre compte' },
          password_reset_requested: { icon: '✉️', text: 'Demande de réinitialisation du mot de passe' },
          password_reset_completed: { icon: '🔒', text: 'Mot de passe modifié' },
          post_create: { icon: '📝', text: 'Publication créée' },
          post: { icon: '📝', text: 'Publication créée' },
          post_created: { icon: '📝', text: 'Publication créée' },
          post_update: { icon: '✏️', text: 'Publication modifiée' },
          post_updated: { icon: '✏️', text: 'Publication modifiée' },
          post_delete: { icon: '🗑️', text: 'Publication supprimée' },
          post_deleted: { icon: '🗑️', text: 'Publication supprimée' },
          comment_create: { icon: '💬', text: 'Commentaire ajouté' },
          comment: { icon: '💬', text: 'Commentaire ajouté' },
          comment_created: { icon: '💬', text: 'Commentaire ajouté' },
          comment_delete: { icon: '🗑️', text: 'Commentaire supprimé' },
          reply_created: { icon: '↩️', text: 'Réponse à un commentaire' },
          like: { icon: '❤️', text: 'Réaction ajoutée' },
          reaction: { icon: '❤️', text: 'Réaction ajoutée' },
          reaction_created: { icon: '👍', text: 'Réaction ajoutée à une publication' },
          reaction_updated: { icon: '👍', text: 'Réaction modifiée' },
          reaction_removed: { icon: '👍', text: 'Réaction retirée' },
          share: { icon: '🔄', text: 'Publication partagée' },
          post_shared: { icon: '↗️', text: 'Publication partagée' },
          friend_request: { icon: '👥', text: "Demande d'ami envoyée" },
          friend_accept: { icon: '✅', text: "Demande d'ami acceptée" },
          friend_remove: { icon: '❌', text: 'Ami retiré' },
          message: { icon: '✉️', text: 'Message envoyé' },
          message_sent: { icon: '📩', text: 'Message envoyé' },
          profile_update: { icon: '👤', text: 'Profil mis à jour' },
          report_created: { icon: '🚩', text: 'Signalement envoyé' },
          report_moderated: { icon: '🛡️', text: 'Signalement traité' }
        };
        return labels[actionType] || { icon: '•', text: actionType || 'Action inconnue' };
      }

      function timeAgo(dateStr) {
        const d = new Date(dateStr);
        const diffSec = Math.floor((Date.now() - d.getTime()) / 1000);
        if (diffSec < 60) return "à l'instant";
        const diffMin = Math.floor(diffSec / 60);
        if (diffMin < 60) return diffMin + ' min';
        const diffH = Math.floor(diffMin / 60);
        if (diffH < 24) return diffH + ' h';
        const diffD = Math.floor(diffH / 24);
        if (diffD < 30) return diffD + ' j';
        return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
      }

      async function loadActivity() {
        const container = document.getElementById('activity-list-container');
        try {
          const res = await fetch('/api/activity');
          if (!res.ok) throw new Error('request failed');
          const rows = await res.json();

          if (!Array.isArray(rows) || rows.length === 0) {
            container.innerHTML = '<p class="muted" style="text-align:center; padding:24px 0;">Aucune activité pour le moment.</p>';
            return;
          }

          container.innerHTML = rows.map(row => {
            const actionType = row.action_type || row.type || '';
            const meta = getActivityLabel(actionType);
            return '<div style="display:flex; align-items:flex-start; gap:12px; padding:12px 0; border-bottom:1px solid var(--border);">' +
              '<div style="width:36px;height:36px;flex:0 0 auto;border-radius:50%;background:rgba(74,124,247,.12);display:flex;align-items:center;justify-content:center;font-size:16px;">' + meta.icon + '</div>' +
              '<div style="flex:1;min-width:0;">' +
                '<div style="font-weight:600;font-size:14.5px;">' + meta.text + '</div>' +
                '<div class="muted" style="font-size:12.5px;margin-top:2px;">' + timeAgo(row.created_at) + '</div>' +
              '</div>' +
            '</div>';
          }).join('');
        } catch (e) {
          container.innerHTML = '<p class="muted" style="text-align:center; padding:24px 0;">Erreur lors du chargement de l\\'activité.</p>';
        }
      }

      loadActivity();
    </script>
  `
}) %>