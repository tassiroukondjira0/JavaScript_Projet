<%- include('../partials/appShell', {
  language: language || 'fr',
  title: 'Activité',
  user,
  currentPath: '/activity',
  body: `
    <section class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
        <h2 style="margin:0;">Activité</h2>
      </div>

      <div id="activity-list-container">
        <p style="color: var(--text-muted); font-size: 0.85rem; text-align: center; padding: 20px 0;">Chargement...</p>
      </div>
    </section>

    <script>
      // Wait for main.js to be loaded and loadActivity to be available
      function waitForLoadActivity() {
        if (typeof window.loadActivity === 'function') {
          window.loadActivity();
        } else {
          setTimeout(waitForLoadActivity, 200);
        }
      }
      waitForLoadActivity();
    </script>
  `
}) %>