<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mot de passe oublié — Djokko</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="top">
    <div class="brand"><div class="logo">Djokko</div></div>
    <div class="actions"><a class="btn" href="/auth/login">Connexion</a></div>
  </header>

  <main class="container">
    <section class="card">
      <h2>Mot de passe oublié</h2>
      <form method="POST" action="/auth/forgot-password">
        <label>Email</label>
        <input name="email" type="email" required />
        <button class="btn btn-primary" type="submit">Envoyer un code OTP</button>
      </form>
    </section>
  </main>
</body>
</html>