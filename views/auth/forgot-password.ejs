<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mot de passe oublié — Djokko</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <script>
    window.__DJOKKO_DISABLE_AUTH_JS__ = true;
  </script>
  <header class="top">
    <div class="brand"><div class="logo">Djokko</div></div>
    <div class="actions"><a class="btn" href="/auth/login">Connexion</a></div>
  </header>

  <main class="container">
    <section class="card" style="max-width:440px;margin:40px auto;">
      <h2>Mot de passe oublié</h2>
      <p class="muted">Indiquez l'adresse e-mail de votre compte : nous vous enverrons un code de vérification par SMS pour réinitialiser votre mot de passe.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="muted" style="color:var(--danger)"><%= error %></p>
      <% } %>

      <form method="POST" action="/auth/forgot-password">
        <label for="email">Adresse e-mail</label>
        <input name="email" id="email" type="email" placeholder="vous@exemple.com" required />
        <button class="btn btn-primary" type="submit" style="margin-top:12px;">Envoyer le code</button>
      </form>

      <p class="muted" style="margin-top:18px;text-align:center;">
        <a href="/auth/login" style="color:var(--primary);text-decoration:none;font-weight:600;">← Retour à la connexion</a>
      </p>
    </section>
  </main>
</body>
</html>
