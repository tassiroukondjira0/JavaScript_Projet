<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('loginTitle') || 'Connexion — Djokko' %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/auth.css" />
</head>
<body class="auth-page">
  <script>
    // Empêche public/js/auth.js (flow /api/auth/*) d’interférer avec le flow EJS /auth/login -> /auth/otp
    window.__DJOKKO_DISABLE_AUTH_JS__ = true;
  </script>
  <div class="auth-split">
    <!-- Panneau de présentation -->
    <aside class="auth-hero">
      <div class="auth-hero-inner">
        <div class="logo auth-logo">Djokko</div>
        <h1>Heureux de vous revoir 👋</h1>
        <p>Connectez-vous pour retrouver vos amis, partager vos moments et suivre l'actualité qui compte pour vous.</p>
        <ul class="auth-bullets">
          <li>🌍 Une communauté francophone vibrante</li>
          <li>💬 Messagerie et notifications en temps réel</li>
          <li>🔒 Vos données, protégées</li>
        </ul>
      </div>
    </aside>

    <!-- Formulaire -->
    <main class="auth-form-side">
      <section class="card auth-card">
        <h2><%= t('login') || 'Connexion' %></h2>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error" style="background:var(--danger-bg);color:var(--danger);padding:10px 14px;border-radius:8px;margin-bottom:16px;font-size:14px;text-align:center;">
            <%= error %>
          </div>
        <% } %>
        <form method="POST" action="/auth/login" class="form">
          <div class="form-group">
            <label for="email">Adresse e-mail</label>
            <input name="email" id="email" type="email" placeholder="" required />
          </div>
          <div class="form-group">
            <label for="password">Mot de passe</label>
            <div class="input-affix">
              <input name="password" id="password" type="password" placeholder="" required />
              <button type="button" class="affix-btn" id="toggle-password" aria-label="Afficher/Masquer le mot de passe">👁️</button>
            </div>
          </div>
          <button class="btn btn-primary auth-submit" type="submit"><%= t('login') || 'Se connecter' %></button>
        </form>
        <p class="muted auth-foot"><%= t('otpFoot') || 'Un code de vérification (OTP) vous sera demandé à l\u2019étape suivante.' %></p>
        <p class="auth-switch">Vous n'avez pas encore de compte ? <a href="/auth/register">Créez-en un</a></p>
      </section>
    </main>
  </div>

  <script>
    // Ne pas déclencher la logique JS alternative d’auth (public/js/auth.js)
    // sur les pages EJS /auth/login et /auth/register.
    window.__DJOKKO_DISABLE_AUTH_JS__ = true;

    // Afficher / masquer le mot de passe
    (function () {
      var btn = document.getElementById('toggle-password');
      var input = document.getElementById('password');
      if (btn && input) {
        btn.addEventListener('click', function () {
          var show = input.type === 'password';
          input.type = show ? 'text' : 'password';
          btn.textContent = show ? '🙈' : '👁️';
        });
      }
    })();
  </script>
</body>
</html>




