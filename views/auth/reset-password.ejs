<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Réinitialiser le mot de passe — Djokko</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/auth.css" />
</head>
<body>
  <script>
    window.__DJOKKO_DISABLE_AUTH_JS__ = true;
  </script>
  <header class="top">
    <div class="brand"><div class="logo">Djokko</div></div>
    <div class="actions"><a class="btn" href="/auth/login">Connexion</a></div>
  </header>

  <main class="container">
    <section class="card" style="max-width:440px;margin:40px auto;">
      <h2>Réinitialiser le mot de passe</h2>
      <p class="muted">Un code de vérification vous a été envoyé par SMS. Saisissez-le ci-dessous avec votre nouveau mot de passe.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="muted" style="color:var(--danger)"><%= error %></p>
      <% } %>

      <form method="POST" action="/auth/reset-password">
        <label for="code">Code OTP</label>
        <input name="code" id="code" inputmode="numeric" pattern="[0-9]*" required />

        <label for="password" style="margin-top:12px;">Nouveau mot de passe</label>
        <div class="input-affix">
          <input name="password" id="password" type="password" minlength="8" required />
          <button type="button" class="affix-btn" id="toggle-password" aria-label="Afficher/Masquer le mot de passe">👁️</button>
        </div>
        <p class="muted" style="font-size:12.5px;margin-top:4px;">8 caractères min. : majuscule, minuscule, chiffre, caractère spécial.</p>

        <button class="btn btn-primary" type="submit" style="margin-top:12px;">Valider</button>
      </form>

      <p class="muted" style="margin-top:18px;text-align:center;">
        <a href="/auth/login" style="color:var(--primary);text-decoration:none;font-weight:600;">← Retour à la connexion</a>
      </p>
    </section>
  </main>

  <script>
    (function () {
      var btn = document.getElementById('toggle-password');
      var input = document.getElementById('password');
      if (btn && input) {
        btn.addEventListener('click', function () {
          var show = input.type === 'password';
          input.type = show ? 'text' : 'password';
          btn.textContent = show ? '🙈' : '👁️';
        });
      }
    })();
  </script>
</body>
</html>
