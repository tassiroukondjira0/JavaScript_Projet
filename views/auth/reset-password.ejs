<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Réinitialiser mot de passe — Djokko</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="top">
    <div class="brand"><div class="logo">Djokko</div></div>
    <div class="actions"><a class="btn" href="/auth/login">Connexion</a></div>
  </header>

  <main class="container">
    <section class="card">
      <h2>Réinitialiser le mot de passe</h2>
      <form method="POST" action="/auth/reset-password">
        <label>Code OTP</label>
        <input name="code" inputmode="numeric" pattern="[0-9]*" required />
        <label>Nouveau mot de passe</label>
        <input name="password" type="password" minlength="8" required />
        <button class="btn btn-primary" type="submit">Valider</button>
      </form>
    </section>
  </main>
</body>
</html>