<% const currentPath = '/posts/search'; %>
<% const title = 'Recherche publications'; %>
<%
  let bodyHtml = '<main><section class="card">';
  bodyHtml += '<h2>Rechercher des publications</h2>';
  bodyHtml += '<input id="searchInput" placeholder="Mot-clé..." />';
  bodyHtml += '<div id="results" style="margin-top:10px;"></div>';
  bodyHtml += '</section></main>';
  bodyHtml += '<script>';
  bodyHtml += 'var input = document.getElementById("searchInput");';
  bodyHtml += 'var results = document.getElementById("results");';
  bodyHtml += 'input.addEventListener("input", function() {';
  bodyHtml += 'var q = input.value.trim();';
  bodyHtml += 'if (q.length < 2) { results.innerHTML = ""; return; }';
  bodyHtml += 'fetch("/posts/search/api?q=" + encodeURIComponent(q)).then(function(r) { return r.json(); }).then(function(data) {';
  bodyHtml += 'var out = [];';
  bodyHtml += '(data || []).forEach(function(p) {';
  bodyHtml += 'var div = document.createElement("div");';
  bodyHtml += 'div.style.cssText = "padding:8px 0;border-bottom:1px solid var(--border)";';
  bodyHtml += 'var strong = document.createElement("strong");';
  bodyHtml += 'strong.textContent = p.fullname || "";';
  bodyHtml += 'div.appendChild(strong);';
  bodyHtml += 'var span = document.createElement("span");';
  bodyHtml += 'span.className = "muted";';
  bodyHtml += 'span.textContent = new Date(p.created_at).toLocaleString();';
  bodyHtml += 'div.appendChild(span);';
  bodyHtml += 'var contentDiv = document.createElement("div");';
  bodyHtml += 'contentDiv.textContent = p.content ? p.content.slice(0, 180) : "";';
  bodyHtml += 'div.appendChild(contentDiv);';
  bodyHtml += 'out.push(div.outerHTML);';
  bodyHtml += '});';
  bodyHtml += 'results.innerHTML = out.join("");';
  bodyHtml += '});';
  bodyHtml += '});';
  bodyHtml += '</script>';
%>
<%- include('partials/appShell', { language: language || 'fr', title, user, currentPath, body: bodyHtml }) %>