<% const currentPath = '/posts'; %>
<% const lang = (typeof language !== 'undefined' && language) ? language : 'fr'; %>
<%
  const tAny = (key) => (typeof t === 'function' ? t(key) : key);
  const p = post || {};
  const postDate = p.created_at ? new Date(p.created_at).toLocaleDateString(lang === 'en' ? 'en-US' : 'fr-FR', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';

  let bodyHtml = '<main style="max-width:680px;margin:0 auto;">';
  bodyHtml += '<a href="/posts" class="btn" style="display:inline-flex;align-items:center;gap:6px;margin-bottom:16px;padding:8px 16px;border-radius:10px;text-decoration:none;">';
  bodyHtml += '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg> Retour au fil d\'actualité';
  bodyHtml += '</a>';

  if (!p.id) {
    bodyHtml += '<div class="card"><p class="muted">Publication introuvable.</p></div>';
  } else {
    bodyHtml += '<article class="post" data-post-id="' + p.id + '" data-user-id="' + p.user_id + '">';
    bodyHtml += '<div class="post-head">';
    bodyHtml += '<div class="avatar avatar-sm">';
    if (p.profile_picture) {
      bodyHtml += '<img src="/uploads/' + p.profile_picture + '" onerror="this.parentNode.textContent=\'👤\'" alt="avatar" />';
    } else {
      bodyHtml += '👤';
    }
    bodyHtml += '</div>';
    bodyHtml += '<div>';
    bodyHtml += '<div class="post-user">' + (p.fullname || '') + '</div>';
    bodyHtml += '<div class="post-date">' + postDate + '</div>';
    bodyHtml += '</div>';
    bodyHtml += '</div>';
    if (p.content) {
      bodyHtml += '<div class="post-content">' + p.content + '</div>';
    }
    if (p.image) {
      bodyHtml += '<img class="post-image" src="/uploads/' + p.image + '" alt="image" />';
    }
    if (p.video) {
      bodyHtml += '<video class="post-video" src="/uploads/' + p.video + '" controls style="width:100%;max-height:480px;border-radius:var(--radius);margin-top:8px;background:#000;"></video>';
    }
    bodyHtml += '<div class="reaction-summary" data-post="' + p.id + '"></div>';
    bodyHtml += '<div class="post-actions-bar">';
    bodyHtml += '<div class="reaction-wrapper">';
    bodyHtml += '<button class="post-action-btn reaction-trigger" data-post="' + p.id + '"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg><span>J\'aime</span></button>';
    bodyHtml += '<div class="reaction-popup" style="display:none;">';
    ['like','love','haha','wow','sad','angry'].forEach(function(t, i) {
      var emojis = ['👍','❤️','😂','😮','😢','😡'];
      bodyHtml += '<button class="reaction-option" data-post="' + p.id + '" data-type="' + t + '" style="font-size:28px;padding:4px;border:none;background:none;cursor:pointer;">' + emojis[i] + '</button>';
    });
    bodyHtml += '</div></div>';
    bodyHtml += '<button class="post-action-btn comment-toggle" data-post="' + p.id + '"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><span>Commenter</span></button>';
    bodyHtml += '<button class="post-action-btn share-toggle" data-post="' + p.id + '"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg><span>Partager</span></button>';
    bodyHtml += '<button class="post-action-btn save-toggle" data-post="' + p.id + '"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg><span>Sauvegarder</span></button>';
    bodyHtml += '</div>';
    bodyHtml += '<div class="comments-section" data-post="' + p.id + '" style="display:block;border-top:1px solid var(--border);padding-top:8px;margin-top:4px;">';
    bodyHtml += '<div class="comments-list" style="max-height:400px;overflow-y:auto;"></div>';
    bodyHtml += '<div class="comment-composer" style="display:flex;gap:8px;margin-top:8px;">';
    bodyHtml += '<input class="input comment-input" placeholder="Écrire un commentaire..." style="flex:1;" />';
    bodyHtml += '<button class="btn btn-primary btn-sm comment-submit" type="button">Envoyer</button>';
    bodyHtml += '</div></div>';
    bodyHtml += '</article>';
  }

  bodyHtml += '<script src="/js/postsInteractions.js"></script>';
  bodyHtml += '</main>';
%>
<%- include('../partials/appShell.ejs', { language: lang, title: 'Publication', user: typeof user !== 'undefined' ? user : null, currentPath, body: bodyHtml }); %>
</write_to_file>