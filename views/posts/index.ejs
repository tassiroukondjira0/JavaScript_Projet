  } else {
    posts.forEach(p => {
      // Determine media type for filtering
      var hasImage = !!(p.image || (p.images && p.images.length > 0));
      var hasVideo = !!p.video;
      var mediaType = hasVideo ? 'video' : (hasImage ? 'photo' : 'none');
      var postDate = formatDate(p.created_at);
      bodyHtml += '<article class="post" data-post-id="' + p.id + '" data-user-id="' + p.user_id + '" data-media-type="' + mediaType + '">';
      bodyHtml += '<div class="post-head">';
      bodyHtml += '<div class="avatar avatar-sm" aria-hidden="true">';
      if (p.profile_picture) {
        bodyHtml += '<img src="/uploads/' + p.profile_picture + '" onerror="this.parentNode.textContent=\'👤\'" alt="avatar" />';
      } else {
        bodyHtml += '👤';
      }
      bodyHtml += '</div>';
      bodyHtml += '<div>';
      bodyHtml += '<div class="post-user">' + p.fullname + '</div>';
      bodyHtml += '<div class="post-date">' + postDate + '</div>';
      bodyHtml += '</div>';
      // Edit/Delete buttons for own posts
      if (user && user.id && Number(p.user_id) === Number(user.id)) {
        bodyHtml += '<div class="post-owner-actions" style="margin-left:auto;display:flex;gap:4px;">';
        bodyHtml += '<button class="edit-post-btn" data-post-id="' + p.id + '" style="background:none;border:none;color:var(--muted);cursor:pointer;padding:4px 8px;border-radius:8px;font-size:13px;" onmouseover="this.style.background=\'var(--hover-bg)\'" onmouseout="this.style.background=\'transparent\'">✏️</button>';
        bodyHtml += '<button class="delete-post-btn" data-post-id="' + p.id + '" style="background:none;border:none;color:var(--muted);cursor:pointer;padding:4px 8px;border-radius:8px;font-size:13px;" onmouseover="this.style.background=\'var(--hover-bg)\'" onmouseout="this.style.background=\'transparent\'">🗑️</button>';
        bodyHtml += '</div>';
      }
      bodyHtml += '</div>';
      if (p.content) {
        bodyHtml += '<div class="post-content">' + p.content + '</div>';
      }
      if (p.images && p.images.length) {
        bodyHtml += '<div class="post-image-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;">';
        p.images.forEach(img => {
          bodyHtml += '<img class="post-image" src="/uploads/' + img.filename + '" alt="image" style="width:100%;height:160px;object-fit:cover;" />';
        });
        bodyHtml += '</div>';
      } else if (p.image) {
        bodyHtml += '<img class="post-image" src="/uploads/' + p.image + '" alt="image" />';
      }
      if (p.video) {
        bodyHtml += '<video class="post-video" src="/uploads/' + p.video + '" controls style="width:100%;max-height:480px;border-radius:var(--radius);margin-top:8px;background:#000;" onerror="this.style.display=\'none\'"></video>';
      }
      
      // Reaction summary (counts row, sits above the divider/buttons like Facebook)
      bodyHtml += '<div class="reaction-summary" data-post="' + p.id + '"></div>';

      // Action buttons bar (Facebook style)
      bodyHtml += '<div class="post-actions-bar">';
      
      // Like button (with reaction popup)
      bodyHtml += '<div class="reaction-wrapper">';
      bodyHtml += '<button class="post-action-btn reaction-trigger" data-post="' + p.id + '">';
      bodyHtml += '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>';
      bodyHtml += '<span>J\'aime</span>';
      bodyHtml += '</button>';
      // Reaction popup
      bodyHtml += '<div class="reaction-popup">';
      bodyHtml += '<button class="reaction-option" data-post="' + p.id + '" data-type="like" style="font-size:28px;padding:4px;border:none;background:none;cursor:pointer;transition:transform .15s;" onmouseover="this.style.transform=\'scale(1.3)\'" onmouseout="this.style.transform=\'scale(1)\'">👍</button>';
      bodyHtml += '<button class="reaction-option" data-post="' + p.id + '" data-type="love" style="font-size:28px;padding:4px;border:none;background:none;cursor:pointer;transition:transform .15s;" onmouseover="this.style.transform=\'scale(1.3)\'" onmouseout="this.style.transform=\'scale(1)\'">❤️</button>';
      bodyHtml += '<button class="reaction-option" data-post="' + p.id + '" data-type="haha" style="font-size:28px;padding:4px;border:none;background:none;cursor:pointer;transition:transform .15s;" onmouseover="this.style.transform=\'scale(1.3)\'" onmouseout="this.style.transform=\'scale(1)\'">😂</button>';
      bodyHtml += '<button class="reaction-option" data-post="' + p.id + '" data-type="wow" style="font-size:28px;padding:4px;border:none;background:none;cursor:pointer;transition:transform .15s;" onmouseover="this.style.transform=\'scale(1.3)\'" onmouseout="this.style.transform=\'scale(1)\'">😮</button>';
      bodyHtml += '<button class="reaction-option" data-post="' + p.id + '" data-type="sad" style="font-size:28px;padding:4px;border:none;background:none;cursor:pointer;transition:transform .15s;" onmouseover="this.style.transform=\'scale(1.3)\'" onmouseout="this.style.transform=\'scale(1)\'">😢</button>';
      bodyHtml += '<button class="reaction-option" data-post="' + p.id + '" data-type="angry" style="font-size:28px;padding:4px;border:none;background:none;cursor:pointer;transition:transform .15s;" onmouseover="this.style.transform=\'scale(1.3)\'" onmouseout="this.style.transform=\'scale(1)\'">😡</button>';
      bodyHtml += '</div>';
      bodyHtml += '</div>';

      // Comment button
      bodyHtml += '<button class="post-action-btn comment-toggle" data-post="' + p.id + '">';
      bodyHtml += '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>';
      bodyHtml += '<span>Commenter</span>';
      bodyHtml += '</button>';

      // Share button
      bodyHtml += '<button class="post-action-btn share-toggle" data-post="' + p.id + '">';
      bodyHtml += '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>';
      bodyHtml += '<span>Partager</span>';
      bodyHtml += '</button>';

      // Save button
      bodyHtml += '<button class="post-action-btn save-toggle" data-post="' + p.id + '">';
      bodyHtml += '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>';
      bodyHtml += '<span>Sauvegarder</span>';
      bodyHtml += '</button>';

