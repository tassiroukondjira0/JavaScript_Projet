  bodyHtml += '</div>';
  bodyHtml += '<div id="storiesList" style="display:flex;gap:12px;"></div>';
  bodyHtml += '</div>';
  bodyHtml += '</section>';

  // Story upload modal
  bodyHtml += '<div id="storyModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.7);z-index:9999;align-items:center;justify-content:center;">';
  bodyHtml += '<div style="background:var(--card);padding:24px;border-radius:16px;max-width:400px;width:90%;">';
  bodyHtml += '<h3>Ajouter une story</h3>';
  bodyHtml += '<p class="muted">La story disparaîtra dans 24h</p>';
  bodyHtml += '<form id="storyForm" enctype="multipart/form-data">';
  bodyHtml += '<button type="button" class="btn" style="display:block;width:100%;margin:12px 0;cursor:pointer;" id="storyFileBtn">';
