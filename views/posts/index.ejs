<% const currentPath = '/posts'; %>
<% const title = 'Publications'; %>
<%
  const tAny = (key) => (typeof t === 'function' ? t(key) : key);
  const fullname = user && user.fullname ? user.fullname : '';
  const userLang = (typeof language !== 'undefined' && language) ? language : 'fr';
  const langLocale = userLang === 'en' ? 'en-US' : 'fr-FR';
  function formatDate(dateStr) {
    if (!dateStr) return '';
    try {
      const d = new Date(dateStr);
      return d.toLocaleDateString(langLocale, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    } catch(e) { return dateStr; }
  }
  let bodyHtml = '<main><h2>Fil d\'actualité</h2>';
  if (user) {
    bodyHtml += '<p class="muted">Bienvenue, <strong>' + fullname + '</strong> 👋</p>';
  }

  // Stories section
  bodyHtml += '<section class="card stories-section" id="storiesSection" style="margin-bottom:16px;">';
  bodyHtml += '<div class="stories-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">';
  bodyHtml += '<h3 style="margin:0;font-size:16px;">Stories</h3>';
  bodyHtml += '</div>';
  bodyHtml += '<div id="storiesContainer" class="stories-container" style="display:flex;gap:12px;overflow-x:auto;padding:4px 0;">';
  bodyHtml += '<div class="story-add" id="storyAddBtn" style="min-width:80px;height:120px;border-radius:12px;background:var(--card-2);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;gap:4px;flex-shrink:0;">';
  bodyHtml += '<div style="width:40px;height:40px;border-radius:50%;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;">+</div>';
