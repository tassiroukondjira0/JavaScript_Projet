  bodyHtml += '<button class="feed-filter-btn" data-filter="video" style="padding:8px 20px;border-radius:20px;border:none;cursor:pointer;font-weight:500;font-size:14px;background:var(--bg-2);color:var(--muted);transition:all .15s;">Vidéos</button>';
  bodyHtml += '</div>';

  // Posts feed
  bodyHtml += '<section class="posts-feed" id="postsFeed">';
