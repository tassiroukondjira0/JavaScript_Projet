<%- include('../partials/appShell', {
  language: language || 'fr',
  title: 'Notifications',
  user,
  currentPath: '/notifications',
  body: `
    <section class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
        <h2 style="margin:0;">Notifications</h2>
        <button class="btn" id="btnMarkRead">Tout marquer comme lu</button>
      </div>

      <div id="notifications-list-container">
        <p style="color: var(--text-muted); font-size: 0.85rem; text-align: center; padding: 20px 0;">Chargement...</p>
      </div>
    </section>

    <script>
      // Wait for main.js to be loaded and loadNotifications to be available
      function waitForLoadNotifications() {
        if (typeof window.loadNotifications === 'function') {
          window.loadNotifications();

          // Mark all as read button
          document.getElementById('btnMarkRead')?.addEventListener('click', async () => {
            await fetch('/api/notifications/read-all', { method: 'PUT' });
            window.loadNotifications();
          });

          // Refresh notifications list in real-time when a new notification arrives
          document.addEventListener('notification_received', function () {
            window.loadNotifications();
          });
        } else {
          setTimeout(waitForLoadNotifications, 200);
        }
      }
      waitForLoadNotifications();
    </script>
  `
}) %>

